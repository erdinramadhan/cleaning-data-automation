# Copy file ini jadi .env, terus isi value-nya
# JANGAN commit file .env ke Git!

# Dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGc...your-service-role-key-here

# Salt buat hashing PII - bikin random string panjang
# Generate sekali, jangan diubah lagi (kalau diubah, hash lama gak match)
PII_HASH_SALT=ganti-ini-jadi-random-string-yang-panjang-dan-rahasia-min-32-char
